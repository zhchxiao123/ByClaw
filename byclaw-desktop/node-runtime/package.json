{
  "name": "@byclaw/node-runtime",
  "version": "0.1.0",
  "description": "ByClaw device node: protocol client, local executors, confirmation, audit. Runs headless via the byclaw-node CLI or embedded in the desktop app.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "bin": { "byclaw-node": "dist/cli.js" },
  "files": ["dist"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
